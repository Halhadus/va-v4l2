#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=meson

override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

override_dh_auto_configure:
	dh_auto_configure -- -Dtests=true -Dhardware_tests=auto -Db_ndebug=false

override_dh_gencontrol:
	libva_version="$$(pkg-config --variable=libva_version libva)"; test -n "$$libva_version" && dpkg --validate-version "$$libva_version" && dh_gencontrol -- -Vlibva:Depends="libva2 (>= $$libva_version)"

override_dh_compress:
	dh_compress -X.md -XCOPYING -XAUTHORS

override_dh_auto_test:
ifneq ($(DEB_BUILD_GNU_TYPE),$(DEB_HOST_GNU_TYPE))
	@:
else ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	@:
else
	dh_auto_test -- --print-errorlogs
endif
